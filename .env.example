# POD Automation — .env Setup Guide
# Copy this file to .env and fill in the values below.
# .env is gitignored — never commit secrets to git.
#
# Setup order:
# 1. Google Gemini (free, instant)
# 2. Etsy (seller account → developer app → OAuth)
# 3. Printful (account → API token)
# 4. Run setup scripts to auto-populate tokens
#
# After filling in all values, run: python main.py

# ────────────────────────────────────────────────────────────────────────────────
# 1. GOOGLE GEMINI (FREE)
# ────────────────────────────────────────────────────────────────────────────────
# Get your API key here: https://aistudio.google.com
# 1. Sign in with your Google account
# 2. Click "Get API key" → "Create new secret key"
# 3. Copy the key and paste it below
GEMINI_API_KEY=

# ────────────────────────────────────────────────────────────────────────────────
# 2. ETSY (SELLER + DEVELOPER APP)
# ────────────────────────────────────────────────────────────────────────────────
# Step A: Create Etsy seller account
#   1. Go to https://www.etsy.com → "Sell on Etsy"
#   2. Create shop (free)
#
# Step B: Register as developer and create app
#   1. Go to https://www.etsy.com/developers/register
#   2. Create an app to get API key + secret
#   3. Note: You must have a seller account first
#
# Step C: Fill in API credentials
ETSY_API_KEY=
ETSY_API_SECRET=

# Step D: Run OAuth to get access token
#   1. Run: python setup_etsy_auth.py
#   2. This opens a browser, completes OAuth, and saves ETSY_ACCESS_TOKEN to .env
#   3. Then continue to Step E
ETSY_ACCESS_TOKEN=

# Step E: Get shop ID and shipping profile ID
#   1. Run: python get_shop_info.py
#   2. This auto-fetches and saves both values to .env
#   3. You're done with Etsy setup
ETSY_SHOP_ID=
ETSY_SHIPPING_PROFILE_ID=

# ────────────────────────────────────────────────────────────────────────────────
# 3. PRINTFUL (ACCOUNT + API TOKEN)
# ────────────────────────────────────────────────────────────────────────────────
# 1. Create account: https://www.printful.com
# 2. Dashboard → Stores → Connect Etsy (link your shop)
# 3. Dashboard → API → Generate token
# 4. Copy the token below
PRINTFUL_API_KEY=

# ────────────────────────────────────────────────────────────────────────────────
# 4. IMAGE GENERATION (OPTIONAL)
# ────────────────────────────────────────────────────────────────────────────────
# Pollinations.ai is used by default — completely FREE, no key needed.
# Optionally use Stability AI for higher quality (free credits on signup):
# https://platform.stability.ai
STABILITY_API_KEY=

# ────────────────────────────────────────────────────────────────────────────────
# 5. APP CONFIGURATION
# ────────────────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
DATABASE_URL=sqlite+aiosqlite:///./data/pod_bot.db

# How often to scan for trends and generate new designs (hours)
SCAN_INTERVAL_HOURS=24

# How many new listings to create per cycle
LISTINGS_PER_CYCLE=5

# Default Printful product type IDs to create designs for
# 71  = Bella+Canvas 3001 Unisex T-Shirt (default, recommended)
# 19  = Gildan 18000 Sweatshirt
# 358 = Gildan 18500 Hoodie
PRODUCT_IDS=71

# Your chosen themes — comma separated, guides trend + design generation
# Examples: funny,dogs,cats,gym,mental_health,nature,vintage,motivational,gaming
THEMES=funny,dogs,gym,motivational,nature,vintage

# Listing price markup over Printful base cost (multiplier)
# Base cost: ~£10 (Bella+Canvas 3001)
# Multiplier: 2.5 → retail £25 (~50% margin after Etsy fees)
PRICE_MULTIPLIER=2.5
