# ── AI (Claude) ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key

# ── Etsy ──────────────────────────────────────────────────────────────────────
# https://www.etsy.com/developers/register
ETSY_API_KEY=your_etsy_keystring
ETSY_API_SECRET=your_etsy_shared_secret
ETSY_ACCESS_TOKEN=your_etsy_oauth_access_token
ETSY_SHOP_ID=your_etsy_shop_id

# ── Printful ───────────────────────────────────────────────────────────────────
# https://www.printful.com/dashboard/store → API → Generate token
PRINTFUL_API_KEY=your_printful_api_key

# ── Image Generation ──────────────────────────────────────────────────────────
# Pollinations.ai is used by default — completely FREE, no key needed.
# To use Stability AI instead set STABILITY_API_KEY (free credits on signup)
STABILITY_API_KEY=

# ── App ────────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
DATABASE_URL=sqlite+aiosqlite:///./data/pod_bot.db

# How often to scan for trends and generate new designs (hours)
SCAN_INTERVAL_HOURS=24

# How many new listings to create per cycle
LISTINGS_PER_CYCLE=5

# Default Printful product type IDs to create designs for
# 71  = Unisex Staple T-Shirt (Bella+Canvas 3001)
# 19  = Mug 11oz
# 358 = Canvas Tote Bag
# 505 = Unisex Heavy Blend Hoodie
PRODUCT_IDS=71,19,358

# Your chosen themes — comma separated, used to guide trend + design generation
# Examples: funny,dogs,cats,gym,mental health,nature,vintage,motivational,gaming
THEMES=funny,dogs,gym,motivational,nature,vintage

# Etsy shipping profile ID (get from Etsy API after setup)
ETSY_SHIPPING_PROFILE_ID=

# Listing price markup over Printful base cost (as multiplier)
# 2.5 = sell at 2.5x cost  e.g. £8 cost → £20 price
PRICE_MULTIPLIER=2.5
